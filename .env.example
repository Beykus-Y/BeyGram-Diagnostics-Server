# ---------------------------------------------------------------------------
# BeyGram report server - example configuration.
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json

DATABASE_PATH=/data/beygram_reports.db

# --- Telegram -----------------------------------------------------------------
# Base URL of the Bot API. Point this at the bundled fake API for local runs.
TELEGRAM_API_BASE=https://api.telegram.org

# Bot that receives `/report <nonce>` confirmations from BeyGram (long polling).
REPORT_BOT_TOKEN=

# Bot used to deliver reports to the developer chat. Empty -> REPORT_BOT_TOKEN.
DELIVERY_BOT_TOKEN=

# Private chat/group id of the developer where reports are delivered.
DELIVERY_CHAT_ID=0

ENABLE_BOT=true
ENABLE_WORKER=true
ENABLE_MAINTENANCE=true

# --- Secrets ------------------------------------------------------------------
# 32+ byte random string. Hashes one-time nonces at rest (HMAC-SHA256).
# Generate with:  python -m app.cli gen-secrets
NONCE_PEPPER=

# --- Access control -----------------------------------------------------------
# Comma separated Telegram user ids seeded into the allowlist on startup.
BOOTSTRAP_ALLOWLIST=
# Global kill switch for accepting reports (also toggleable at runtime via CLI).
ACCEPT_REPORTS=true

# --- Admin web panel ----------------------------------------------------------
# Empty -> panel fully disabled (404). Intended for a private network or an
# identity-aware reverse proxy; do not expose to the public internet.
ADMIN_TOKEN=
ADMIN_SESSION_TTL_SECONDS=3600
ADMIN_LOGIN_ATTEMPTS_PER_HOUR=10
ADMIN_PAGE_SIZE=25

# --- Protocol limits ----------------------------------------------------------
NONCE_TTL_SECONDS=420
MAX_BODY_BYTES=262144
MAX_DESCRIPTION_CHARS=2000
MAX_SUMMARY_CHARS=8000
MAX_EVENTS=2000
MAX_EVENT_MESSAGE_CHARS=500
MAX_EVENT_ATTR_VALUE_CHARS=200
MAX_EVENT_ATTRS=24

# --- Transport ----------------------------------------------------------------
REQUIRE_HTTPS=true
TRUST_PROXY_HOPS=1
# Дополнительные доверенные сети для X-Forwarded-* (CIDR через запятую).
TRUSTED_PROXY_NETWORKS_RAW=

# --- Rate limits --------------------------------------------------------------
RL_USER_REPORTS_PER_DAY=5
RL_USER_REPORTS_PER_WINDOW=2
RL_USER_REPORTS_WINDOW_SECONDS=600
RL_USER_REPORT_CMD_PER_HOUR=10
RL_GLOBAL_REPORTS_PER_DAY=500
RL_IP_REPORTS_PER_HOUR=20
RL_GLOBAL_REPORT_CMD_PER_HOUR=500

# --- Worker -------------------------------------------------------------------
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_MAX_ATTEMPTS=6
WORKER_LEASE_SECONDS=180
WORKER_BACKOFF_BASE_SECONDS=15

# --- Retention / maintenance --------------------------------------------------
RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=60
MAINTENANCE_INTERVAL_SECONDS=900

# --- Bot polling --------------------------------------------------------------
BOT_POLL_TIMEOUT_SECONDS=50
BOT_POLL_INTERVAL_SECONDS=1
BOT_ERROR_BACKOFF_SECONDS=5
